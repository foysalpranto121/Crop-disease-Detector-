# Copy to backend/.env (git-ignored) and fill in real values.

# JWT signing key. Leave empty in development: a random key is generated into data/.secret_key.
SECRET_KEY=

# Admin login (always created on first start) — use a strong password in production.
# SEED_DEMO_USERS also creates a demo farmer account — set to false in production.
SEED_DEMO_USERS=true
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123

# Krishi AI chatbot (EURI, https://euron.one/euri). Empty = chat answers from the offline disease library.
EURI_API_KEY=
EURI_MODEL=gemini-2.5-flash-lite

# Diagnosis tuning
LOW_CONFIDENCE_THRESHOLD=0.6
MIN_PLANT_RATIO=0.06

# Allowed browser origins (JSON list) when the frontend runs on another port
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
