# Copy to .env and change as needed.

# true  = use built-in mock data (no backend needed) — default
# false = call the real FastAPI backend
VITE_USE_MOCKS=true

# Leave empty to call /api on the same origin (the dev server proxies it to http://localhost:8000).
VITE_API_URL=

# --- AI chatbot (server-side only — put real values in .env.local, never commit them) ---
# EURI API key (https://euron.one/euri). Without it the chatbot answers from the offline disease library.
EURI_API_KEY=
# Any chat model from https://api.euron.one/api/v1/euri/models
EURI_MODEL=gemini-2.5-flash-lite
